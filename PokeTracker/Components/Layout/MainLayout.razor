@inherits LayoutComponentBase
@inject Services.FileService fileService

<div class="page">
    <!--
    <div class="sidebar">
        <NavMenu />
    </div>
    -->
    <main>
        <div class="top-row px-4 main-navbar">
            @if(fileService.savePath == string.Empty || fileService.savePath == null)
            {
                <NavLink href="/">Select Save</NavLink>
            }
            else
            {
                <NavLink href="/teamview">Team</NavLink>
                <NavLink href="/">Select Save</NavLink>
                <NavLink href="/pokedex">Pokedex</NavLink>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code{
    protected override void OnInitialized()
    {
        fileService.StateChanged += OnSavePathChanged;
    }

    private void OnSavePathChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        fileService.StateChanged -= OnSavePathChanged;
    }

}
