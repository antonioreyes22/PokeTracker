@page "/pokedex"

@using PokeTracker.Models;
@using PokeTracker.Services;
@inject Services.FileService fileService;

<div class="pokedex-title">
    <h1>Pokédex</h1>

    <p>On this page, you can see all the Pokémon you have caught or not. You can select the Regional or National Pokédex</p>
</div>

<div class="bttn-filter-container">
    <div class="bttn-all"><button @onclick="() => SwitchFilter(0)">All</button></div>
    <div class="bttn-caught"><button @onclick="() => SwitchFilter(1)">Seen</button></div>
    <div class="bttn-seen"><button @onclick="() => SwitchFilter(2)">Caught</button></div>

    <div class="bttn-national-dex"><button @onclick="() => SwitchPokedex(0)">National</button></div>
    <div class="bttn-regional-dex"><button @onclick="() => SwitchPokedex(1)">Regional</button></div>
</div>

<div class="pokedex-container">
    @if(pokedexFilter == 0)
    {
        @for(int i=1; i<=386; i++)
        {
            @if(filter == 0)
            {
                <div class="pkmn-in-pokedex @PokemonStyle(myPokedex[i - 1])">
                    <img src="@(myPokedex[i - 1] != 0 ? $"images/icons/{i}.png" : "images/icons/0.png")" alt="Pokémon" />
                </div>
            }
            else
            {
                @if(filter <= myPokedex[i-1])
                {
                    <div class="pkmn-in-pokedex @PokemonStyle(myPokedex[i - 1])">
                        <img src="@($"images/icons/{i}.png")" alt="Pokémon" />
                    </div>
                }
                
            }
        }
    }
    else
    {
        @foreach (var entry in mapDex)
        {
            @if(filter == 0)
            {
                <div class="pkmn-in-pokedex @PokemonStyle(myPokedex[entry.Value-1])">
                    <img src="@(myPokedex[entry.Value-1] != 0 ? $"images/icons/{entry.Value}.png" : "images/icons/0.png")" alt="Pokémon" />
                </div>
            }
            else
            {
                @if (filter <= myPokedex[entry.Value-1])
                {
                    <div class="pkmn-in-pokedex @PokemonStyle(myPokedex[entry.Value-1])">
                        <img src="@($"images/icons/{entry.Value}.png")" alt="Pokémon" />
                    </div>
                }
            }
        }
    }
    
</div>

