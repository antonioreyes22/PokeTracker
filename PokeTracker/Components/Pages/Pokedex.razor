    protected override async Task OnInitializedAsync()
    {
        savReader = new SavReader(fileService.savePath);

        for (int i = 1; i <= 386; i++)
        {
            if (await savReader.GetPokemonSeenCaught(i) == 2)
            {
                myPokedex.Add(2);
            }
            else if (await savReader.GetPokemonSeenCaught(i) == 1)
